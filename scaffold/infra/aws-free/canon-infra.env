# Canon infrastructure config. Checked in. NON-SECRET values only.
# Secrets belong in SSM Parameter Store; list parameter names, never values.
# AWS free-tier terms change: verify against current AWS terms (last checked: 2026-10-10, not verified live).
CANON_INFRA_PROVIDER=aws-free
CANON_INFRA_REGION=us-east-1
# Optional. Pins the deploy to one account: wrong credentials then fail instead of landing elsewhere.
# CANON_INFRA_ACCOUNT_ID=123456789012
# Optional. Stack id and SSM path root (/<name>/<env>/). Change it when several apps share an account.
# CANON_INFRA_APP_NAME=CanonApp
# merge | manual | tag | none
CANON_INFRA_DEPLOY=merge
CANON_INFRA_BUDGET_USD=5
# Budget alerts go here. Must be changed before the first deploy.
CANON_INFRA_BUDGET_EMAIL=CHANGE_ME@example.invalid
CANON_INFRA_ENV_NAME=prod
# Set to true only if you knowingly leave the free tier (downgrades guardrail errors to warnings).
# CANON_INFRA_ALLOW_PAID=true

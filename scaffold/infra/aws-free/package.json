{
  "name": "canon-infra-aws-free",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canon starter: AWS free-tier stack (CDK, TypeScript). Verify against current AWS free-tier terms.",
  "scripts": {
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "cdk-nag": "^2.34.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
